# ─────────────────────────────────────────────────────────────────────────────
#  ImmoFinder — environment
#
#  Copy this file to `.env` next to docker-compose.yml and fill in the values:
#
#      cp .env.example .env
#
#  `.env` is gitignored. Only this template is committed — never put real
#  secrets in it.
#
#  `PORT` and `NODE_ENV` are not listed here: docker-compose.yml sets them for the
#  container and they are not meant to be changed from the outside.
# ─────────────────────────────────────────────────────────────────────────────


# ── Required: web UI access ──────────────────────────────────────────────────
# ImmoFinder has no user accounts. One shared password protects the whole
# instance, and it is enforced fail-closed: if either value below is missing or
# too short, EVERY route answers 503 — including the login page itself.

# The password everyone logs in with. Minimum 12 characters.
# Changing it immediately invalidates all existing sessions.
APP_PASSWORD=

# Signing key for the session cookie. Minimum 32 random characters.
# Generate one with:  openssl rand -hex 32
# Changing it also invalidates all existing sessions.
AUTH_SECRET=


# ── Optional: Fredy API credentials ──────────────────────────────────────────
# The web UI logs into Fredy's API to read jobs and to trigger scrape runs.
# These are the credentials of a Fredy user — on a fresh Fredy install that is
# `admin` / `admin`, which you should change in the Fredy UI on first login.
# Without them the app still shows listings, but the Scraping page is inert.
FREDY_API_USER=
FREDY_API_PASSWORD=


# ── Networking ───────────────────────────────────────────────────────────────
# Interface the published ports bind to. The default keeps both services on
# localhost, which is the right choice unless you put a reverse proxy in front.
# Use 0.0.0.0 to expose them on the host's network — only do that behind a
# firewall or a VPN, and never without HTTPS.
BIND_ADDRESS=127.0.0.1

# Host ports. Change these if something else already uses them, or to run a
# second instance alongside the first (see docs/multi-instance.md).
WEBUI_PORT=3000
FREDY_PORT=9998


# ── Reverse proxy / HTTPS ────────────────────────────────────────────────────
# Set to 1 when a reverse proxy in front of ImmoFinder reliably sets
# X-Forwarded-For and X-Forwarded-Proto. Only the right-most X-Forwarded-For
# entry is trusted; without this flag no forwarded header is believed at all.
TRUST_PROXY=

# Set to 1 once the instance is reachable over HTTPS only. Logging in over an
# unencrypted connection then stops issuing sessions at all.
# Leave EMPTY while you reach the app over plain http, or login will not work.
REQUIRE_HTTPS=


# ── Optional ─────────────────────────────────────────────────────────────────
# UI language for visitors who have not picked one yet: `en` or `de`.
DEFAULT_LOCALE=en

# Sent to OpenStreetMap's Nominatim when resolving addresses. Their usage policy
# asks for an application name and a way to make contact — please put your own
# contact address here if you geocode more than occasionally.
# https://operations.osmfoundation.org/policies/nominatim/
GEOCODER_USER_AGENT=

# Fredy image tag. `master` follows upstream; pin a version (e.g. 26.5.1) if you
# prefer to upgrade deliberately.
FREDY_IMAGE_TAG=master

# Memory ceiling for the Fredy container. Headless Chromium is why it needs this
# much; lower it only if scraping stays stable for you.
FREDY_MEMORY_LIMIT=2G

# Base URL of Fredy's API as seen from the web UI container. The default resolves
# inside the Compose network and only needs changing if you run Fredy elsewhere.
FREDY_API_URL=http://fredy:9998

# Docker Compose project name. Change it to run several isolated instances from
# the same checkout (see docs/multi-instance.md).
COMPOSE_PROJECT_NAME=immofinder

# Where the two SQLite databases live on the host, relative to this file.
DATA_DIR=./data
